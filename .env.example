# Telegram
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID администраторов через запятую. Узнать свой: @userinfobot
ADMIN_IDS=123456789

# Хранилище
DB_PATH=data/leadbot.sqlite3

# Режим webhook. Пусто = long polling.
# На Render заполняется автоматически из RENDER_EXTERNAL_URL.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me
PORT=8080

# Необязательно: Google Sheets через Apps Script
SHEETS_WEBHOOK_URL=

# Локальный прокси (на хостинге оставить пустым)
PROXY_URL=

# Поведение
LOG_LEVEL=INFO
RATE_LIMIT_SECONDS=0.7
DAILY_LEAD_LIMIT=3
SUPPORT_CONTACT=@leadflow_support
